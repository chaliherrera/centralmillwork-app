# Backend URL — leave empty in local dev (Vite proxy handles /api → localhost:4000)
# Set to your Railway backend URL in production:
# VITE_BACKEND_URL=https://centralmillwork-app-production.up.railway.app
VITE_BACKEND_URL=

# Recepción por CANTIDADES (F2). "true" muestra el input de cantidad por material en
# la pantalla de Recepciones; cualquier otro valor (o ausente) deja el checkbox de siempre.
# En local se prende en .env.local; en prod, en la env var del servicio frontend en Railway.
# VITE_RECEPCION_CANTIDADES=true
